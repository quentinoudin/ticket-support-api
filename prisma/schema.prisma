generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OneTimeTokenType {
  INVITE
  PASSWORD_RESET
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  role         UserRole
  status       UserStatus @default(INVITED)
  createdById  String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Verrouillage temporaire après trop d'échecs de connexion consécutifs.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdBy     User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]         @relation("UserCreatedBy")
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  tickets       Ticket[]
  messages      TicketMessage[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OneTimeToken {
  id        String           @id @default(uuid())
  userId    String
  type      OneTimeTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Journal d'audit : pas de clé étrangère vers User, pour que l'historique survive
// à la suppression d'un compte.
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// --- Assistant IA ---

// Où en est le traitement du ticket par l'assistant. Indépendant du statut OPEN/IN_PROGRESS/CLOSED.
enum AiHandling {
  NONE
  PENDING
  ANSWERED
  ESCALATED
  OFF_TOPIC
}

enum AiCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCOUNT_ACCESS
  EMAIL
  PRINTING
  SECURITY
  OTHER
}

enum MessageSender {
  USER
  STAFF
  AI
}

enum AiRunKind {
  TRIAGE
  REPLY
}

enum AiRunOutcome {
  OK
  INVALID_OUTPUT
  ERROR
  TIMEOUT
  BUDGET
}

enum AiJobType {
  TRIAGE_AND_REPLY
  FOLLOW_UP
}

enum AiJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Ticket {
  id          String         @id @default(uuid())
  title       String         @db.VarChar(200)
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?

  // Priorité choisie par l'utilisateur, conservée quand l'IA la reclasse.
  requestedPriority     TicketPriority?
  // Une fois fixée à la main par un agent ou un admin, l'IA n'y touche plus.
  priorityLockedByHuman Boolean         @default(false)
  aiPriorityReason      String?         @db.VarChar(200)
  aiCategory            AiCategory?
  aiHandling            AiHandling      @default(NONE)
  aiEscalationReason    String?         @db.VarChar(60)

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages  TicketMessage[]
  aiJobs    AiJob[]

  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([aiHandling])
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  sender    MessageSender
  authorId  String?
  content   String        @db.Text
  createdAt DateTime      @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

// Journal de chaque appel à l'IA. Jamais le texte des prompts ni des réponses : seulement
// de quoi mesurer le coût et les pannes. Sans clé étrangère, il survit à la suppression d'un ticket.
model AiRun {
  id               String       @id @default(uuid())
  kind             AiRunKind
  model            String
  promptVersion    String
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  latencyMs        Int          @default(0)
  outcome          AiRunOutcome
  ticketId         String?
  userId           String?
  createdAt        DateTime     @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([ticketId])
}

// File de tâches de l'assistant, traitée par le serveur.
model AiJob {
  id        String      @id @default(uuid())
  type      AiJobType
  ticketId  String
  messageId String?
  status    AiJobStatus @default(QUEUED)
  attempts  Int         @default(0)
  runAfter  DateTime    @default(now())
  lockedAt  DateTime?
  // Court et sans donnée du ticket : seulement un code d'erreur.
  lastError String?     @db.VarChar(120)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([ticketId])
}