PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL="postgresql://ticket_user:ticket_password@localhost:5433/ticket_support?schema=public"
DATABASE_URL_TEST="postgresql://ticket_user:ticket_password@localhost:5433/ticket_support_test?schema=public"

JWT_ACCESS_SECRET=remplacez-par-une-valeur-aleatoire-de-32-caracteres-minimum
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
INVITE_TTL_HOURS=48
RESET_TTL_MINUTES=60

# Derrière un reverse proxy (nginx, Cloudflare...) : mettre le nombre de proxys de confiance (ex. 1).
# Laissé à 0, toutes les requêtes semblent venir du proxy et les limites par IP sont partagées.
TRUST_PROXY=0
# Documentation /docs et /openapi.json : active par défaut hors production.
# DOCS_ENABLED=false

SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="Support Tickets <no-reply@ticket.local>"
# Optionnel : envoi par l'API HTTP de Brevo (port 443) quand le réseau bloque le SMTP.
# Si cette clé est renseignée, elle remplace le SMTP ci-dessus.
BREVO_API_KEY=

SUPER_ADMIN_EMAIL=superadmin@ticket.local
SUPER_ADMIN_PASSWORD=ChangeMe-12345

# --- Assistant IA (DeepSeek), désactivé par défaut ---
# La clé est partagée et contrôlée par un tiers : ne la commitez jamais, ne la collez nulle part.
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS_TRIAGE=300
AI_MAX_TOKENS_REPLY=700
# Plafond de jetons par jour pour toute l'application (environ 100 tickets).
AI_DAILY_TOKEN_BUDGET=200000
AI_USER_DAILY_RUNS=20
# Nombre maximal de réponses de l'IA par ticket avant de passer la main à un humain.
AI_MAX_TURNS=3
AI_OFFTOPIC_MIN_CONFIDENCE=0.8
AI_REPLY_MIN_CONFIDENCE=0.6
